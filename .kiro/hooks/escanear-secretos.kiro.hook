{
  "enabled": true,
  "name": "Escanear secretos (manual)",
  "description": "Busca claves, tokens o credenciales de AWS escritas en el código antes de hacer commit",
  "version": "1",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Revisa los archivos modificados o nuevos del repositorio (usa git status y git diff) en busca de claves, tokens, contraseñas o credenciales de AWS escritas en el código, en archivos de configuración o en los steering. Lista cada hallazgo con el archivo y la línea, sin repetir el valor encontrado. No edites ningún archivo. Si no hay nada, responde solo: Sin secretos."
  }
}
